# Published root layout; other root files and folders stay local
/*
!/.gitignore
!/README.md
!/Backend/
!/Frontend/
!/docs/
# All-in-one image and browser-based Heroku deployment
!/Dockerfile
!/.dockerignore
!/.gitattributes
!/heroku.yml
!/app.json
