# Environment files and secrets (all directories, including uppercase variants)
.[eE][nN][vV]*
*.[eE][nN][vV]
*.[eE][nN][vV].*
[eE][nN][vV]
# Keep env.example, .env.example, and named *.env.example templates trackable
![eE][nN][vV].[eE][xX][aA][mM][pP][lL][eE]
!*.[eE][nN][vV].[eE][xX][aA][mM][pP][lL][eE]

