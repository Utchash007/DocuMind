# DocuMind backend (FastAPI) — copy to repository-root .env or set in environment.
# Never commit real credentials. Keys are loaded by app code; see docs/v2-contracts.md.

# PostgreSQL (SQLAlchemy 2 + Alembic + psycopg)
# Application + worker must share the same database. Use TLS/pooling in production.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/documind
# Live tests can truncate/downgrade their database. Authorize a dedicated test
# database ONLY in the invoking shell, never in this application .env file:
# $env:TEST_DATABASE_URL="postgresql+psycopg://user:password@host:5432/documind_test"
# It must differ from DATABASE_URL and have a clearly test-only database name.

# Appwrite (server-side, FastAPI)
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_STORAGE_BUCKET_ID=

# Vector search (Chroma Cloud)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=Documind
# Legacy presence flag for /health only (not used to construct client)
CHROMA_HOST=

# LLM
GROQ_API_KEY=

# Embeddings: DOCUMIND_EMBEDDING_PROVIDER=hf (default, 384-d) or jina (1024-d).
# Jina AI keys are free to create at https://jina.ai (trial tokens included).
DOCUMIND_EMBEDDING_PROVIDER=hf
# Hugging Face (optional bearer token; HF_API_KEY takes precedence over HF_TOKEN)
HF_API_KEY=
HF_TOKEN=
# Jina AI (required when DOCUMIND_EMBEDDING_PROVIDER=jina)
JINA_API_KEY=
# JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small

# Browser calls normally use the same-origin Next.js proxy. No wildcard CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Legacy filename APIs have no user ownership. Keep disabled on public deployments.
ENABLE_LEGACY_API=false
# Mock embeddings are explicit development/test opt-in, never production fallback.
DOCUMIND_ALLOW_MOCK_EMBEDDINGS=false
# Worker overrides must be >= the public API's 25 MiB / 200-page budgets.
DOCUMIND_WORKER_MAX_FILE_BYTES=26214400
DOCUMIND_WORKER_MAX_PAGES=200
