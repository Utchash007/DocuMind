# Root Dockerfile build context (./Dockerfile, context = repository root).
# Everything the build COPYs is re-created inside the image; the rest stays out.
# Secrets must never enter the build context.

# Git and local tooling
.git
.agents
.kiro
.vscode
.idea
opencode.json
skills-lock.json
*.suo
*.log
next-panic-*.log
*.tsbuildinfo

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/.next
**/out
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# Runtime data
Backend/uploads
*.db
*.sqlite3
.chroma

# Secrets never enter the build context or an image layer
**/.env
**/.env.*
**/*.env
**/*.env.*

# Not needed to build the image
docs
*.md
Frontend/redesign

# The build definition itself does not need to be in the context
Dockerfile
.dockerignore
