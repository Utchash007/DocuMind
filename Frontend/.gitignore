# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files and secrets (including uppercase variants)
.[eE][nN][vV]*
*.[eE][nN][vV]
*.[eE][nN][vV].*
[eE][nN][vV]
# Keep env.example, .env.example, and named *.env.example templates trackable
![eE][nN][vV].[eE][xX][aA][mM][pP][lL][eE]
!*.[eE][nN][vV].[eE][xX][aA][mM][pP][lL][eE]

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
