BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Optional public endpoint/project fallbacks; server-only values below take precedence.
# Authentication uses /api/auth/*, not the Appwrite browser SDK.
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Server-only (Next.js, never NEXT_PUBLIC) — used by /api/auth/* to obtain
# HttpOnly sessions and mint short-lived JWTs for FastAPI.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Storage bucket configuration belongs to the backend, not Next.js.
